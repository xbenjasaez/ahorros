<UserControl x:Class="Ahorro.Views.Budget.BudgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:Ahorro.Models.Enums;assembly=Ahorro.Models"
             Background="{StaticResource Brush.BackgroundApp}">
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/Ahorro.Views;component/SharedResources.xaml"/>
        <Style x:Key="BudgetGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAlert}" Value="True">
                    <Setter Property="Background" Value="#18FFB84D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:BudgetLineStatus.Exceeded}">
                    <Setter Property="Background" Value="#18FF6B6B"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageHeader}" Text="Presupuesto mensual"/>
                    <TextBlock Foreground="{StaticResource Brush.TextSecondary}" Text="{Binding PeriodLabel}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <ComboBox ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriodOption}"
                              DisplayMemberPath="Label" Width="240" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource AccentButton}" Content="Actualizar" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource KpiCardBorder}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Ingreso bruto" Foreground="{StaticResource Brush.TextSecondary}" FontSize="{StaticResource FontSize.Caption}"/>
                        <TextBox Text="{Binding GrossIncomeInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,4"/>
                        <TextBlock Text="{Binding GrossIncome}" FontSize="18" Foreground="{StaticResource Brush.AccentCyan}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource KpiCardBorder}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Ingreso líquido disponible" Foreground="{StaticResource Brush.TextSecondary}" FontSize="{StaticResource FontSize.Caption}"/>
                        <TextBox Text="{Binding NetIncomeInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,4"/>
                        <TextBlock Text="{Binding NetIncome}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Brush.PositiveGreen}"/>
                        <Button Style="{StaticResource PremiumButton}" Content="Guardar ingresos" Command="{Binding SaveIncomeCommand}"
                                Margin="0,10,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource KpiCardBorder}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Planificado / Real" Foreground="{StaticResource Brush.TextSecondary}" FontSize="{StaticResource FontSize.Caption}"/>
                        <TextBlock Margin="0,10,0,0">
                            <Run Text="{Binding TotalPlanned}" Foreground="{StaticResource Brush.AccentCyan}" FontSize="18" FontWeight="SemiBold"/>
                            <Run Text=" / " Foreground="{StaticResource Brush.TextSecondary}"/>
                            <Run Text="{Binding TotalActual}" Foreground="{StaticResource Brush.AlertAmber}" FontSize="18" FontWeight="SemiBold"/>
                        </TextBlock>
                        <TextBlock Text="{Binding RemainingBudget}" FontSize="14" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,8,0,0"/>
                        <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}">
                            <Run Text="Ejecución: "/>
                            <Run Text="{Binding ExecutionPercent}" Foreground="{StaticResource Brush.PositiveGreen}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource KpiCardBorder}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Regla 50 / 30 / 20" Foreground="{StaticResource Brush.TextSecondary}" FontSize="{StaticResource FontSize.Caption}"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Necesidades" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NeedsPercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Deseos" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WantsPercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ahorro" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SavingsPercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RuleTotalLabel}" FontSize="11"
                                       Foreground="{StaticResource Brush.PositiveGreen}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RuleTotalValid}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.CriticalRed}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource KpiCardBorder}">
                    <StackPanel>
                        <TextBlock Text="Acciones" Foreground="{StaticResource Brush.TextSecondary}" FontSize="{StaticResource FontSize.Caption}" Margin="0,0,0,10"/>
                        <Button Style="{StaticResource AccentButton}" Content="Recalcular distribución" Command="{Binding RecalculateDistributionCommand}" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource PremiumButton}" Content="Duplicar mes anterior" Command="{Binding DuplicatePreviousMonthCommand}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Brush.TextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource AlertStripBorder}">
                <ItemsControl ItemsSource="{Binding Alerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource Brush.AlertAmber}" TextWrapping="Wrap" Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Style="{StaticResource KpiCardBorder}" Margin="0,0,0,16" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="0,0,8,0"
                                 Tag="Nueva categoría"/>
                        <ComboBox ItemsSource="{Binding GroupOptions}" SelectedItem="{Binding SelectedGroupOption}"
                                  DisplayMemberPath="Label" Width="140" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource AccentButton}" Content="+ Categoría" Command="{Binding AddCategoryCommand}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                  DisplayMemberPath="Name" Width="160" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding NewSubcategoryName, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,8,0"
                                 Tag="Nueva subcategoría"/>
                        <Button Style="{StaticResource AccentButton}" Content="+ Subcategoría" Command="{Binding AddSubcategoryCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                      Style="{StaticResource PremiumDataGrid}" MinHeight="420"
                      AutoGenerateColumns="False" CanUserSortColumns="True" IsReadOnly="True"
                      RowStyle="{StaticResource BudgetGridRow}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Categoría" Width="130" SortMemberPath="Category">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{Binding CategoryBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource Brush.TextPrimary}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Subcategoría" Binding="{Binding Subcategory}" Width="120"/>
                    <DataGridTextColumn Header="Tipo asignación" Binding="{Binding AllocationMode}" Width="110"/>
                    <DataGridTextColumn Header="Presupuesto" Binding="{Binding Planned}" Width="115">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Brush.AccentCyan}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Real" Binding="{Binding Actual}" Width="115">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Diferencia" Binding="{Binding Difference}" Width="115">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Brush.PositiveGreen}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:BudgetLineStatus.Exceeded}">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.CriticalRed}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="% usado" Width="140" SortMemberPath="UsedPercent">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <ProgressBar Style="{StaticResource BudgetUsageProgressBar}"
                                                 Value="{Binding UsedPercent}"
                                                 Foreground="{Binding ProgressBrush}"/>
                                    <TextBlock Text="{Binding UsedPercentText}" FontSize="11" Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAlert}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.AlertAmber}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:BudgetLineStatus.Exceeded}">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.CriticalRed}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Estado" Width="100" SortMemberPath="StatusLabel">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource BudgetStatusBadge}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:BudgetLineStatus.Exceeded}">
                                                    <Setter Property="Background" Value="#33FF6B6B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:BudgetLineStatus.Attention}">
                                                    <Setter Property="Background" Value="#33FFB84D"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:BudgetLineStatus.Limit}">
                                                    <Setter Property="Background" Value="#3327D3FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusBrush}" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding SelectLineForSubcategoryCommand}" CommandParameter="{Binding SelectedLine}"/>
                </DataGrid.InputBindings>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
