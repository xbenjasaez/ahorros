<Window x:Class="Ahorro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ahorro — Presupuesto personal"
        Height="900" Width="1440"
        MinHeight="700" MinWidth="1100"
        Background="{StaticResource Brush.BackgroundApp}"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.Primary}">
    <Grid DataContext="{Binding}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,28,20,24">
                    <TextBlock Text="◆ AHORRO" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brush.AccentCyan}"/>
                    <TextBlock Text="Control financiero" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Margin="8,0">
                    <RadioButton Style="{StaticResource SidebarNavItem}" Content="Dashboard" GroupName="Nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
                    <RadioButton Style="{StaticResource SidebarNavItem}" Content="Presupuesto" GroupName="Nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="Budget"/>
                    <RadioButton Style="{StaticResource SidebarNavItem}" Content="Movimientos" GroupName="Nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="Transactions"/>
                    <RadioButton Style="{StaticResource SidebarNavItem}" Content="Metas" GroupName="Nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="Goals"/>
                    <RadioButton Style="{StaticResource SidebarNavItem}" Content="Pagos" GroupName="Nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="Payments"/>
                    <RadioButton Style="{StaticResource SidebarNavItem}" Content="Reportes" GroupName="Nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="Reports"/>
                    <RadioButton Style="{StaticResource SidebarNavItem}" Content="Configuración" GroupName="Nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="CLP · Offline" FontSize="10"
                           Foreground="{StaticResource Brush.TextSecondary}" Margin="20" VerticalAlignment="Bottom"/>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" Margin="0"/>
    </Grid>
</Window>
