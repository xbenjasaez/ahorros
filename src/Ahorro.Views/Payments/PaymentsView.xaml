<UserControl x:Class="Ahorro.Views.Payments.PaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Ahorro.Themes.Converters;assembly=Ahorro.Themes"
             Background="{StaticResource Brush.BackgroundApp}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Ahorro.Views;component/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

            <Style x:Key="PaymentSummaryCard" TargetType="Border" BasedOn="{StaticResource KpiCardBorder}">
                <Setter Property="Padding" Value="18"/>
                <Setter Property="MinHeight" Value="96"/>
            </Style>

            <Style x:Key="UpcomingPaymentCard" TargetType="Border" BasedOn="{StaticResource KpiCardBorder}">
                <Setter Property="Padding" Value="14"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
                <Setter Property="MinWidth" Value="200"/>
            </Style>

            <Style x:Key="CalendarDayCell" TargetType="Border">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Background" Value="#141C26"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderSubtle}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style x:Key="StatusBadge" TargetType="Border">
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageHeader}" Text="Pagos y vencimientos"/>
                        <TextBlock Foreground="{StaticResource Brush.TextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="{Binding ActiveCountLabel}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Style="{StaticResource GhostButton}" Content="Actualizar" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource AccentButton}" Content="+ Agregar programado" Command="{Binding OpenNewPaymentCommand}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PaymentSummaryCard}" Margin="0,0,12,0"
                            BorderBrush="#FF6B6B">
                        <StackPanel>
                            <TextBlock Text="VENCIDOS" Foreground="{StaticResource Brush.TextSecondary}" FontSize="10"/>
                            <TextBlock Text="{Binding OverdueLabel}" FontSize="28" FontWeight="Bold"
                                       Foreground="#FF6B6B" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource PaymentSummaryCard}" Margin="0,0,12,0"
                            BorderBrush="{StaticResource Brush.AccentCyan}">
                        <StackPanel>
                            <TextBlock Text="PRÓXIMOS" Foreground="{StaticResource Brush.TextSecondary}" FontSize="10"/>
                            <TextBlock Text="{Binding UpcomingLabel}" FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource Brush.AccentCyan}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource PaymentSummaryCard}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="PENDIENTES" Foreground="{StaticResource Brush.TextSecondary}" FontSize="10"/>
                            <TextBlock Text="{Binding PendingLabel}" FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource Brush.TextPrimary}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource PaymentSummaryCard}" Background="#121A24">
                        <StackPanel>
                            <TextBlock Text="POR PAGAR ESTE MES" Foreground="{StaticResource Brush.TextSecondary}" FontSize="10"/>
                            <TextBlock Text="{Binding DueThisMonthLabel}" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.PositiveGreen}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="Próximos vencimientos" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" Margin="0,0,0,20">
                    <ItemsControl ItemsSource="{Binding UpcomingHighlights}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource UpcomingPaymentCard}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}"/>
                                            <Border Style="{StaticResource StatusBadge}" HorizontalAlignment="Right"
                                                    Background="#1A2430">
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="10"
                                                           Foreground="{Binding StatusBrush}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Amount}" FontSize="20" FontWeight="Bold"
                                                   Foreground="{StaticResource Brush.AccentCyan}" Margin="0,8,0,0"/>
                                        <TextBlock Text="{Binding DueDate}" FontSize="11"
                                                   Foreground="{StaticResource Brush.TextSecondary}" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding DaysLabel}" FontSize="11"
                                                   Foreground="{Binding StatusBrush}" Margin="0,2,0,8"/>
                                        <Button Style="{StaticResource AccentButton}" Content="Registrar pago"
                                                Command="{Binding DataContext.RegisterPaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding CanRegister, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Style="{StaticResource KpiCardBorder}" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Estado" Foreground="{StaticResource Brush.TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox Width="150" ItemsSource="{Binding StatusFilterOptions}"
                                      SelectedItem="{Binding SelectedStatusFilter}" DisplayMemberPath="Label"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="Desde" Foreground="{StaticResource Brush.TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding FilterDateFrom}" Width="140"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Hasta" Foreground="{StaticResource Brush.TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding FilterDateTo}" Width="140"/>
                        </StackPanel>
                        <Button Grid.Column="3" Style="{StaticResource GhostButton}" Content="Restablecer fechas"
                                Command="{Binding ClearDateFiltersCommand}" VerticalAlignment="Bottom"/>
                    </Grid>
                </Border>

                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Brush.PositiveGreen}"
                           Margin="0,0,0,12" Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Text="Listado de pagos programados" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                <DataGrid ItemsSource="{Binding FilteredItems}" Style="{StaticResource PremiumDataGrid}"
                          AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="280">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="110"/>
                        <DataGridTextColumn Header="Método" Binding="{Binding PaymentMethod}" Width="100"/>
                        <DataGridTextColumn Header="Monto" Binding="{Binding Amount}" Width="100"/>
                        <DataGridTextColumn Header="Vence" Binding="{Binding DueDate}" Width="100"/>
                        <DataGridTextColumn Header="Frecuencia" Binding="{Binding FrequencyLabel}" Width="90"/>
                        <DataGridTextColumn Header="Recordatorio" Binding="{Binding ReminderLabel}" Width="130"/>
                        <DataGridTemplateColumn Header="Estado" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusBadge}" Background="#1A2430">
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="11"
                                                   Foreground="{Binding StatusBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource AccentButton}" Content="Registrar"
                                                Command="{Binding DataContext.RegisterPaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Margin="0,0,6,0"
                                                Visibility="{Binding CanRegister, Converter={StaticResource BoolToVis}}"/>
                                        <Button Style="{StaticResource GhostButton}" Content="Editar"
                                                Command="{Binding DataContext.OpenEditPaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="1" Margin="16,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource KpiCardBorder}" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding CalendarMonthLabel}"/>
                    <TextBlock Text="Calendario de vencimientos" Foreground="{StaticResource Brush.TextSecondary}"
                               FontSize="11" Margin="0,4,0,12"/>
                    <UniformGrid Columns="7" Margin="0,0,0,8">
                        <TextBlock Text="L" Foreground="{StaticResource Brush.TextSecondary}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock Text="M" Foreground="{StaticResource Brush.TextSecondary}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock Text="X" Foreground="{StaticResource Brush.TextSecondary}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock Text="J" Foreground="{StaticResource Brush.TextSecondary}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock Text="V" Foreground="{StaticResource Brush.TextSecondary}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock Text="S" Foreground="{StaticResource Brush.TextSecondary}" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock Text="D" Foreground="{StaticResource Brush.TextSecondary}" FontSize="10" HorizontalAlignment="Center"/>
                    </UniformGrid>
                    <ItemsControl ItemsSource="{Binding CalendarDays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border ToolTip="{Binding Tooltip}" BorderBrush="{Binding AccentBrush}"
                                        Width="36" Height="44" Margin="2" CornerRadius="8"
                                        Background="#141C26" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="0.35"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentCyan}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBlock Text="{Binding DayNumber}" FontSize="12"
                                                   Foreground="{StaticResource Brush.TextPrimary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                        <Ellipse Width="6" Height="6" Fill="{Binding AccentBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                                 Visibility="{Binding HasPayments, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Ellipse Width="8" Height="8" Fill="#FF6B6B" Margin="0,0,6,0"/>
                        <TextBlock Text="Vencido" FontSize="10" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,12,0"/>
                        <Ellipse Width="8" Height="8" Fill="#27D3FF" Margin="0,0,6,0"/>
                        <TextBlock Text="Próximo" FontSize="10" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,12,0"/>
                        <Ellipse Width="8" Height="8" Fill="#93A4BD" Margin="0,0,6,0"/>
                        <TextBlock Text="Pendiente" FontSize="10" Foreground="{StaticResource Brush.TextSecondary}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource KpiCardBorder}" Padding="20"
                    Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding EditorTitle}"/>
                        <TextBlock Text="Nombre del pago" Foreground="{StaticResource Brush.TextSecondary}" FontSize="11" Margin="0,12,0,4"/>
                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <TextBlock Text="Monto estimado (CLP)" Foreground="{StaticResource Brush.TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditAmountInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <TextBlock Text="Fecha de vencimiento (yyyy-MM-dd)" Foreground="{StaticResource Brush.TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditDueDateInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <TextBlock Text="Categoría" Foreground="{StaticResource Brush.TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding EditCategory}"
                                  DisplayMemberPath="Name" Margin="0,0,0,12"/>

                        <TextBlock Text="Método de pago" Foreground="{StaticResource Brush.TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding PaymentMethodOptions}" SelectedItem="{Binding EditPaymentMethod}"
                                  DisplayMemberPath="Name" Margin="0,0,0,12"/>

                        <TextBlock Text="Frecuencia recurrente" Foreground="{StaticResource Brush.TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding FrequencyOptions}" SelectedItem="{Binding EditFrequency}"
                                  DisplayMemberPath="Label" Margin="0,0,0,12"/>

                        <TextBlock Text="Recordatorio anticipado (días)" Foreground="{StaticResource Brush.TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditReminderDays, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource AccentButton}" Content="Guardar" Command="{Binding SavePaymentCommand}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource GhostButton}" Content="Cancelar" Command="{Binding CancelEditCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
