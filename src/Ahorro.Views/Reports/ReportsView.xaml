<UserControl x:Class="Ahorro.Views.Reports.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="{StaticResource Brush.BackgroundApp}">
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/Ahorro.Views;component/SharedResources.xaml"/>
    </UserControl.Resources>
    <ScrollViewer Padding="24">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageHeader}" Text="Reportes"/>
                    <TextBlock Text="{Binding PeriodLabel}" Foreground="{StaticResource Brush.TextSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource AccentButton}" Content="Exportar Excel" Command="{Binding ExportExcelCommand}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource PremiumButton}" Content="Exportar PDF" Command="{Binding ExportPdfCommand}"/>
                </StackPanel>
            </Grid>
            <Border Style="{StaticResource KpiCardBorder}" Margin="0,0,0,16">
                <TextBlock>
                    <Run Text="Ahorro acumulado en metas: " Foreground="{StaticResource Brush.TextSecondary}"/>
                    <Run Text="{Binding AccumulatedSavings}" Foreground="{StaticResource Brush.PositiveGreen}" FontSize="18"/>
                </TextBlock>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource KpiCardBorder}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Gasto por categoría"/>
                        <lvc:PieChart Series="{Binding CategorySeries}" Height="240"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Tendencia mensual"/>
                        <lvc:CartesianChart Series="{Binding TrendSeries}" Height="240"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Style="{StaticResource KpiCardBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Top gastos"/>
                    <ItemsControl ItemsSource="{Binding TopExpenses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource Brush.TextPrimary}" Margin="0,4"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
