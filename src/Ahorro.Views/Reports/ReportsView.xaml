<UserControl x:Class="Ahorro.Views.Reports.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:conv="clr-namespace:Ahorro.Themes.Converters;assembly=Ahorro.Themes"
             Background="{StaticResource Brush.BackgroundApp}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Ahorro.Views;component/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageHeader}" Text="Reportes"/>
                    <TextBlock Foreground="{StaticResource Brush.TextSecondary}" Text="{Binding PeriodLabel}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <ComboBox ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriodOption}"
                              DisplayMemberPath="Label" Width="240" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource GhostButton}" Content="Actualizar" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource KpiCardBorder}" Margin="0,0,0,16" Padding="14"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Brush.AccentCyan}" TextWrapping="Wrap"/>
            </Border>

            <ItemsControl ItemsSource="{Binding SummaryKpis}" Margin="0,0,0,20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource KpiCardBorder}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource Brush.TextSecondary}" FontSize="{StaticResource FontSize.Caption}" Text="{Binding Title}"/>
                                <TextBlock Foreground="{Binding AccentBrush}" FontSize="20" FontWeight="Bold" Text="{Binding Value}" Margin="0,6,0,0"/>
                                <TextBlock Foreground="{StaticResource Brush.TextSecondary}" FontSize="{StaticResource FontSize.Caption}" Text="{Binding Subtitle}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource KpiCardBorder}" Margin="0,0,0,16" Padding="16">
                <Grid>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Ahorro acumulado en metas"/>
                        <TextBlock Text="{Binding AccumulatedSavings}" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.PositiveGreen}" Margin="0,8,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource PremiumButton}" Content="Metas Excel" Command="{Binding ExportGoalsExcelCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource PremiumButton}" Content="Metas PDF" Command="{Binding ExportGoalsPdfCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiCardBorder}" Margin="0,0,12,0" Padding="16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Gasto por categoría"/>
                        <lvc:PieChart Series="{Binding CategorySeries}" Height="260"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource KpiCardBorder}" Padding="16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Tendencia mensual"/>
                        <lvc:CartesianChart Series="{Binding TrendSeries}" Height="260"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource KpiCardBorder}" Margin="0,0,0,16" Padding="16">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Ahorro acumulado por periodo"/>
                    <lvc:CartesianChart Series="{Binding SavingsSeries}" Height="220"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiCardBorder}" Margin="0,0,12,0" Padding="16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Top gastos"/>
                        <ItemsControl ItemsSource="{Binding TopExpenses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="22" Height="22" CornerRadius="11" Background="#1E2A38" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Rank}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource Brush.AccentCyan}" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Amount}" HorizontalAlignment="Right"
                                                   Foreground="{StaticResource Brush.AlertAmber}" FontWeight="SemiBold"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource KpiCardBorder}" Padding="16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Categorías más excedidas"/>
                        <ItemsControl ItemsSource="{Binding ExceededCategories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,6" Padding="10" CornerRadius="8" Background="#141C26" BorderBrush="#2A3F55" BorderThickness="1">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Category}" Foreground="{Binding AccentBrush}" FontWeight="SemiBold"/>
                                                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}">
                                                    <Run Text="Plan: "/><Run Text="{Binding Planned}"/>
                                                    <Run Text=" · Real: "/><Run Text="{Binding Actual}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Text="{Binding UsedPercent}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="#FF6B6B" FontWeight="Bold" FontSize="14"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource KpiCardBorder}" Padding="16">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Exportaciones" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Style="{StaticResource AccentButton}" Content="Movimientos → Excel"
                                Command="{Binding ExportTransactionsExcelCommand}" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource PremiumButton}" Content="Presupuesto → Excel"
                                Command="{Binding ExportBudgetExcelCommand}" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource PremiumButton}" Content="Presupuesto → PDF"
                                Command="{Binding ExportBudgetPdfCommand}" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource AccentButton}" Content="Reporte general → PDF"
                                Command="{Binding ExportReportPdfCommand}" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource GhostButton}" Content="Metas → Excel"
                                Command="{Binding ExportGoalsExcelCommand}" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource GhostButton}" Content="Metas → PDF"
                                Command="{Binding ExportGoalsPdfCommand}" Margin="0,0,8,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
