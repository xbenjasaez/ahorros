<UserControl x:Class="Ahorro.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Ahorro.Themes.Converters;assembly=Ahorro.Themes"
             Background="{StaticResource Brush.BackgroundApp}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Ahorro.Views;component/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <Style x:Key="SettingsTabItem" TargetType="TabItem">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Bd" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent">
                                <ContentPresenter ContentSource="Header"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.AccentCyan}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.AccentCyan}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>
            <DataTemplate x:Key="ColorSwatchTemplate">
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <Ellipse Width="18" Height="18" Fill="{Binding Swatch}" Stroke="{StaticResource Brush.BorderSubtle}" StrokeThickness="1"/>
                    <TextBlock Text="{Binding Hex}" Foreground="{StaticResource Brush.TextSecondary}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource PageHeader}" Text="Configuración"/>
            <TextBlock Foreground="{StaticResource Brush.TextSecondary}" Text="Perfil, periodos, categorías, alertas, apariencia y exportación — persistencia local."
                       TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource KpiCardBorder}" Margin="0,0,0,16" Padding="12,10"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Brush.AccentCyan}" TextWrapping="Wrap"/>
        </Border>

        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0"
                    SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Perfil" Style="{StaticResource SettingsTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <Border Style="{StaticResource KpiCardBorder}" MaxWidth="640">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Nombre visible"/>
                            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Correo (opcional)"/>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,18"/>
                            <Button Style="{StaticResource AccentButton}" Content="Guardar perfil" Command="{Binding SaveProfileCommand}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Periodo" Style="{StaticResource SettingsTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <Border Style="{StaticResource KpiCardBorder}" MaxWidth="640">
                        <StackPanel>
                            <TextBlock Text="Ciclo presupuestario" Foreground="{StaticResource Brush.TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Día de corte mensual (1–28)"/>
                            <TextBox Text="{Binding CutoffDay, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Frecuencia del periodo"/>
                            <ComboBox ItemsSource="{Binding FrequencyOptions}" SelectedItem="{Binding SelectedFrequency}"
                                      DisplayMemberPath="Label" Width="280" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            <TextBlock Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" FontSize="{StaticResource FontSize.Caption}"
                                       Text="Quincenal divide el mes en dos ventanas de seguimiento alineadas al día de corte." Margin="0,0,0,18"/>
                            <Button Style="{StaticResource AccentButton}" Content="Guardar periodo" Command="{Binding SavePeriodCommand}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Categorías" Style="{StaticResource SettingsTabItem}">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource KpiCardBorder}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="Categorías base" Foreground="{StaticResource Brush.TextPrimary}" FontWeight="SemiBold"/>
                                <CheckBox Content="Mostrar inactivas" IsChecked="{Binding ShowInactiveCategories}" Margin="0,10,0,0"
                                          Foreground="{StaticResource Brush.TextSecondary}"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Style="{StaticResource PremiumButton}" Content="+" Command="{Binding AddCategoryCommand}" Padding="12,8"/>
                                </Grid>
                                <ComboBox ItemsSource="{Binding GroupOptions}" SelectedItem="{Binding SelectedNewGroup}"
                                          DisplayMemberPath="Label" Margin="0,8,0,0"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                     DisplayMemberPath="Name" BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource KpiCardBorder}">
                        <StackPanel>
                            <TextBlock Text="Detalle de categoría" Foreground="{StaticResource Brush.TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Nombre"/>
                            <TextBox Text="{Binding SelectedCategory.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Grupo presupuestario"/>
                            <ComboBox ItemsSource="{Binding GroupOptions}" SelectedItem="{Binding SelectedEditGroup}"
                                      DisplayMemberPath="Label" Margin="0,0,0,12"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Color"/>
                            <ListBox ItemsSource="{Binding CategoryColorPresets}" SelectedItem="{Binding SelectedCategoryColor}"
                                     ItemTemplate="{StaticResource ColorSwatchTemplate}" MaxHeight="140" Margin="0,0,0,12"/>
                            <CheckBox Content="Permitir arrastre de saldo (rollover)" IsChecked="{Binding EditCategoryRollover}"
                                      Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,14"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Button Style="{StaticResource AccentButton}" Content="Guardar categoría" Command="{Binding SaveSelectedCategoryCommand}" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource PremiumButton}" Content="↑" Command="{Binding MoveCategoryUpCommand}" Margin="0,0,4,0" Padding="10,8"/>
                                <Button Style="{StaticResource PremiumButton}" Content="↓" Command="{Binding MoveCategoryDownCommand}" Margin="0,0,8,0" Padding="10,8"/>
                                <Button Style="{StaticResource PremiumButton}" Content="Activar/Desactivar" Command="{Binding ToggleCategoryActiveCommand}"/>
                            </StackPanel>

                            <TextBlock Text="Subcategorías" Foreground="{StaticResource Brush.TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewSubcategoryName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Style="{StaticResource PremiumButton}" Content="Agregar" Command="{Binding AddSubcategoryCommand}"/>
                            </Grid>
                            <DataGrid ItemsSource="{Binding Subcategories}" SelectedItem="{Binding SelectedSubcategory}"
                                      Style="{StaticResource PremiumDataGrid}" MaxHeight="200" Margin="0,0,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nombre" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridTextColumn Header="Estado" Binding="{Binding StatusLabel}" Width="90" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource AccentButton}" Content="Guardar subcategoría" Command="{Binding SaveSelectedSubcategoryCommand}" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource PremiumButton}" Content="Activar/Desactivar sub" Command="{Binding ToggleSubcategoryActiveCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Pagos" Style="{StaticResource SettingsTabItem}">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KpiCardBorder}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Métodos de pago" Foreground="{StaticResource Brush.TextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource PremiumButton}" Content="Nuevo" Command="{Binding NewPaymentMethodCommand}" Margin="12,0,0,0"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}"
                                      Style="{StaticResource PremiumDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding TypeLabel}" Width="120"/>
                                    <DataGridTextColumn Header="Tarjeta" Binding="{Binding CreditCardName}" Width="140"/>
                                    <DataGridTextColumn Header="Estado" Binding="{Binding StatusLabel}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource KpiCardBorder}">
                        <StackPanel>
                            <TextBlock Text="Editar método" Foreground="{StaticResource Brush.TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Nombre"/>
                            <TextBox Text="{Binding PaymentMethodName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Tipo"/>
                            <ComboBox ItemsSource="{Binding PaymentTypeOptions}" SelectedItem="{Binding SelectedPaymentType}"
                                      DisplayMemberPath="Label" Margin="0,0,0,12"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Tarjeta de crédito (si aplica)"/>
                            <ComboBox ItemsSource="{Binding CreditCardOptions}" SelectedItem="{Binding SelectedCreditCard}"
                                      DisplayMemberPath="Name" Margin="0,0,0,18"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource AccentButton}" Content="Guardar" Command="{Binding SavePaymentMethodCommand}" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource PremiumButton}" Content="Activar/Desactivar" Command="{Binding TogglePaymentMethodActiveCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Alertas" Style="{StaticResource SettingsTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <Border Style="{StaticResource KpiCardBorder}" MaxWidth="640">
                        <StackPanel>
                            <CheckBox Content="Alertas de presupuesto activas" IsChecked="{Binding AlertsEnabled}"
                                      Foreground="{StaticResource Brush.TextPrimary}" Margin="0,0,0,16"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Umbral de atención (%)"/>
                            <TextBox Text="{Binding AttentionThreshold, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Umbral de límite (%)"/>
                            <TextBox Text="{Binding LimitThreshold, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            <TextBlock Foreground="{StaticResource Brush.TextSecondary}" FontSize="{StaticResource FontSize.Caption}" TextWrapping="Wrap"
                                       Text="Las líneas del presupuesto cambian a estado Atención y Límite según estos porcentajes de ejecución." Margin="0,0,0,18"/>
                            <Button Style="{StaticResource AccentButton}" Content="Guardar alertas" Command="{Binding SaveAlertsCommand}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Metas" Style="{StaticResource SettingsTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <Border Style="{StaticResource KpiCardBorder}" MaxWidth="640">
                        <StackPanel>
                            <TextBlock Text="Comportamiento de metas de ahorro" Foreground="{StaticResource Brush.TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,14"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Ritmo mensual de referencia (CLP)"/>
                            <TextBox Text="{Binding GoalMonthlyPaceInput, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                            <CheckBox Content="Mostrar proyecciones y estimaciones" IsChecked="{Binding GoalShowProjections}"
                                      Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,10"/>
                            <CheckBox Content="Celebrar metas al completarlas" IsChecked="{Binding GoalAutoCelebrate}"
                                      Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,10"/>
                            <CheckBox Content="Sugerir aportes según ritmo configurado" IsChecked="{Binding GoalSuggestContributions}"
                                      Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,18"/>
                            <Button Style="{StaticResource AccentButton}" Content="Guardar metas" Command="{Binding SaveGoalsBehaviorCommand}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Apariencia" Style="{StaticResource SettingsTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <Border Style="{StaticResource KpiCardBorder}" MaxWidth="640">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Moneda principal"/>
                            <ComboBox ItemsSource="{Binding CurrencyOptions}" SelectedItem="{Binding SelectedCurrency}"
                                      DisplayMemberPath="Label" Width="320" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Variante de tema oscuro"/>
                            <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"
                                      DisplayMemberPath="Label" Width="320" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Color de acento"/>
                            <ListBox ItemsSource="{Binding AccentOptions}" SelectedItem="{Binding SelectedAccent}"
                                     ItemTemplate="{StaticResource ColorSwatchTemplate}" MaxHeight="160" Margin="0,0,0,18"/>
                            <Button Style="{StaticResource AccentButton}" Content="Guardar apariencia" Command="{Binding SaveAppearanceCommand}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Exportación" Style="{StaticResource SettingsTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <StackPanel MaxWidth="720">
                        <Border Style="{StaticResource KpiCardBorder}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Carpeta predeterminada"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding ExportFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Style="{StaticResource PremiumButton}" Content="Examinar" Command="{Binding BrowseExportFolderCommand}" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Style="{StaticResource PremiumButton}" Content="Abrir" Command="{Binding OpenExportFolderCommand}"/>
                                </Grid>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Prefijo de archivos"/>
                                <TextBox Text="{Binding ExportFilePrefix, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                <CheckBox Content="Incluir notas en exportaciones" IsChecked="{Binding ExportIncludeNotes}" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,8"/>
                                <CheckBox Content="Incluir gráficos en PDF de reportes" IsChecked="{Binding ExportPdfCharts}" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,8"/>
                                <CheckBox Content="Abrir Excel automáticamente al exportar" IsChecked="{Binding ExportExcelAutoOpen}" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,16"/>
                                <Button Style="{StaticResource AccentButton}" Content="Guardar exportación" Command="{Binding SaveExportSettingsCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource KpiCardBorder}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="Historial reciente" Foreground="{StaticResource Brush.TextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource PremiumButton}" Content="Actualizar" Command="{Binding RefreshExportHistoryCommand}" Margin="12,0,0,0"/>
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding ExportHistory}" Style="{StaticResource PremiumDataGrid}" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tipo" Binding="{Binding TypeLabel}" Width="120"/>
                                        <DataGridTextColumn Header="Archivo" Binding="{Binding FileName}" Width="*"/>
                                        <DataGridTextColumn Header="Fecha" Binding="{Binding CreatedLabel}" Width="140"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Usuarios" Style="{StaticResource SettingsTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <Border Style="{StaticResource KpiCardBorder}" MaxWidth="640">
                        <StackPanel>
                            <TextBlock Text="{Binding MultiUserDescription}" Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                            <CheckBox Content="Habilitar gestión multi-perfil en este equipo" IsChecked="{Binding MultiUserEnabled}"
                                      Foreground="{StaticResource Brush.TextPrimary}" Margin="0,0,0,14"/>
                            <ListBox ItemsSource="{Binding UserProfiles}" SelectedItem="{Binding SelectedUser}"
                                     DisplayMemberPath="DisplayName" MaxHeight="180" Margin="0,0,0,14"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource AccentButton}" Content="Cambiar perfil activo" Command="{Binding SwitchUserCommand}" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource PremiumButton}" Content="Guardar preferencia" Command="{Binding SaveMultiUserSettingsCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
