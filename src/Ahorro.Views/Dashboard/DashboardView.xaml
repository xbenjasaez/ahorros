<UserControl x:Class="Ahorro.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:conv="clr-namespace:Ahorro.Themes.Converters;assembly=Ahorro.Themes"
             Background="{StaticResource Brush.BackgroundApp}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Ahorro.Views;component/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

            <Style x:Key="DashboardKpiCard" TargetType="Border" BasedOn="{StaticResource KpiCardBorder}">
                <Setter Property="Padding" Value="16,14"/>
                <Setter Property="MinHeight" Value="100"/>
            </Style>

            <Style x:Key="DashboardPanelCard" TargetType="Border" BasedOn="{StaticResource KpiCardBorder}">
                <Setter Property="Padding" Value="16"/>
            </Style>

            <Style x:Key="DashboardAlertRow" TargetType="Border">
                <Setter Property="Background" Value="#141C26"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderSubtle}"/>
            </Style>

            <Style x:Key="DashboardGoalProgress" TargetType="ProgressBar" BasedOn="{StaticResource GoalHeroProgressBar}">
                <Setter Property="Height" Value="10"/>
            </Style>

            <Style x:Key="DashboardStatusBadge" TargetType="Border">
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="6,3"/>
                <Setter Property="Background" Value="#1A2430"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageHeader}" Text="Centro de mando"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Border Background="#1A2A35" BorderBrush="{StaticResource Brush.AccentCyan}"
                                BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                            <TextBlock Text="{Binding ActivePeriodBadge}" Foreground="{StaticResource Brush.AccentCyan}"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"
                                   Text="{Binding PeriodLabel}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <ComboBox Style="{StaticResource PremiumComboBox}"
                              ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriodOption}"
                              DisplayMemberPath="Label" Width="240" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource GhostButton}" Content="Actualizar" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>

            <!-- KPIs -->
            <ItemsControl ItemsSource="{Binding Kpis}" Margin="0,0,0,20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DashboardKpiCard}" Margin="0,0,12,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Foreground="{StaticResource Brush.TextSecondary}"
                                           FontSize="{StaticResource FontSize.Caption}" Text="{Binding Title}"/>
                                <TextBlock Foreground="{Binding AccentBrush}" FontSize="21" FontWeight="Bold"
                                           Text="{Binding Value}" Margin="0,6,0,0"/>
                                <TextBlock Foreground="{StaticResource Brush.TextSecondary}"
                                           FontSize="10" Text="{Binding Subtitle}" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Hero + lateral -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource DashboardPanelCard}" Margin="0,0,12,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Presupuesto vs real" Margin="0"/>
                                <TextBlock Text="{Binding ComparisonSubtitle}" FontSize="11"
                                           Foreground="{StaticResource Brush.TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                    <Border Width="10" Height="10" CornerRadius="2" Background="#27D3FF" Margin="0,0,6,0"/>
                                    <TextBlock Text="Planificado" FontSize="10" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="10" Height="10" CornerRadius="2" Background="#35E0A1" Margin="0,0,6,0"/>
                                    <TextBlock Text="Real" FontSize="10" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <lvc:CartesianChart Series="{Binding ComparisonSeries}"
                                            XAxes="{Binding ComparisonXAxes}"
                                            YAxes="{Binding ComparisonYAxes}"
                                            LegendPosition="{Binding ComparisonLegendPosition}"
                                            Height="300"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource DashboardPanelCard}" Margin="0,0,0,12" MinHeight="200">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Próximos pagos"/>
                            <TextBlock DockPanel.Dock="Top" Text="Sin pagos pendientes"
                                       Foreground="{StaticResource Brush.TextSecondary}" FontSize="11" Margin="0,0,0,8"
                                       Visibility="{Binding HasUpcomingPayments, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="160">
                                <ItemsControl ItemsSource="{Binding UpcomingPayments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,0,0,1"
                                                    Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Brush.TextPrimary}" FontSize="13"/>
                                                        <TextBlock FontSize="10" Foreground="{StaticResource Brush.TextSecondary}">
                                                            <Run Text="{Binding DueDate}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding DaysLabel}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Amount}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Brush.AccentCyan}" VerticalAlignment="Center"
                                                               Margin="0,0,10,0"/>
                                                    <Border Grid.Column="2" Style="{StaticResource DashboardStatusBadge}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusLabel}" FontSize="9"
                                                                   Foreground="{Binding StatusBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource DashboardPanelCard}" MinHeight="220">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Alertas"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Alerts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource DashboardAlertRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="4"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{Binding AccentBrush}" CornerRadius="2" Margin="0,0,10,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                                                   Foreground="{Binding AccentBrush}"/>
                                                        <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"
                                                                   Foreground="{StaticResource Brush.TextPrimary}" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Franja inferior -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="0.85*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource DashboardPanelCard}" Margin="0,0,12,0" MinHeight="240">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Distribución" Margin="0"/>
                            <TextBlock Text="{Binding DistributionSubtitle}" FontSize="11"
                                       Foreground="{StaticResource Brush.TextSecondary}"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <lvc:PieChart Grid.Column="0" Series="{Binding DistributionSeries}" Height="180"/>
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0">
                                <ItemsControl ItemsSource="{Binding DistributionLegend}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="8" Height="8" CornerRadius="2"
                                                        Background="{Binding AccentBrush}" VerticalAlignment="Top" Margin="0,3,6,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Category}" FontSize="11"
                                                               Foreground="{StaticResource Brush.TextPrimary}"/>
                                                    <TextBlock FontSize="10" Foreground="{StaticResource Brush.TextSecondary}">
                                                        <Run Text="{Binding Amount}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding PercentLabel}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource DashboardPanelCard}" Margin="0,0,12,0" MinHeight="240">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Tendencia mensual"/>
                        <lvc:CartesianChart Series="{Binding TrendSeries}"
                                            XAxes="{Binding TrendXAxes}"
                                            YAxes="{Binding TrendYAxes}"
                                            LegendPosition="{Binding TrendLegendPosition}"
                                            Height="200"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource DashboardPanelCard}" MinHeight="240">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Metas activas"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ActiveGoals}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Brush.TextPrimary}"
                                                           FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="{Binding PercentText}" HorizontalAlignment="Right"
                                                           Foreground="{Binding AccentBrush}" FontWeight="SemiBold" FontSize="12"/>
                                            </Grid>
                                            <ProgressBar Style="{StaticResource DashboardGoalProgress}"
                                                         Value="{Binding Progress}" Maximum="1"
                                                         Foreground="{Binding AccentBrush}"
                                                         Background="{Binding TrackBrush}"/>
                                            <TextBlock FontSize="10" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,4,0,0">
                                                <Run Text="{Binding Accumulated}"/>
                                                <Run Text=" / "/>
                                                <Run Text="{Binding Target}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Fila final -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource DashboardPanelCard}" Margin="0,0,12,0">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Categorías críticas"/>
                        <ItemsControl ItemsSource="{Binding CriticalCategories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="48"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Category}" Foreground="{StaticResource Brush.TextPrimary}" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding UsedPercent}" HorizontalAlignment="Right"
                                                   Foreground="{StaticResource Brush.AlertAmber}" FontWeight="SemiBold" FontSize="12"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource DashboardPanelCard}">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Movimientos recientes"/>
                        <ItemsControl ItemsSource="{Binding RecentTransactions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Date}" FontSize="10"
                                                   Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="8,0">
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource Brush.TextPrimary}" FontSize="12"/>
                                            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource Brush.TextSecondary}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Amount}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
