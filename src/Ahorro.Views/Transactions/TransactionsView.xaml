<UserControl x:Class="Ahorro.Views.Transactions.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:Ahorro.Models.Enums;assembly=Ahorro.Models"
             Background="{StaticResource Brush.BackgroundApp}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Ahorro.Views;component/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:HexToBrushConverter xmlns:conv="clr-namespace:Ahorro.Themes.Converters;assembly=Ahorro.Themes" x:Key="HexToBrush"/>
            <conv:BoolToVisibilityConverter xmlns:conv="clr-namespace:Ahorro.Themes.Converters;assembly=Ahorro.Themes" x:Key="BoolToVis"/>
        </ResourceDictionary>
        <Style x:Key="TxActionButton" TargetType="Button" BasedOn="{StaticResource PremiumButton}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
        <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="280"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="#1A2430"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Style="{StaticResource PageHeader}" Text="Movimientos"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Brush.TextSecondary}"
                           FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBox Style="{StaticResource SearchBox}" Margin="0,0,8,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Buscar por descripción, nota o etiqueta"/>
                <ComboBox ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriodOption}"
                          DisplayMemberPath="Label" Width="220" Margin="0,0,8,0"/>
                <Button Style="{StaticResource PremiumButton}" Content="Filtros" Command="{Binding ToggleAdvancedFiltersCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource PremiumButton}" Content="Exportar" Command="{Binding ExportCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource AccentButton}" Content="+ Nuevo" Command="{Binding StartAddCommand}"/>
            </StackPanel>
        </Grid>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding QuickFilters}" Margin="0,0,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ToggleButton Style="{StaticResource FilterChipToggle}" Content="{Binding Label}"
                                  IsChecked="{Binding IsActive, Mode=TwoWay}"
                                  Command="{Binding DataContext.ToggleQuickFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="2" Style="{StaticResource KpiCardBorder}" Margin="0,0,0,12" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FilterSummary}" Foreground="{StaticResource Brush.TextPrimary}" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text=" · " Foreground="{StaticResource Brush.TextSecondary}" Margin="4,0"/>
                    <TextBlock Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center">
                        <Run Text="Ingresos "/>
                        <Run Text="{Binding SummaryIncome}" Foreground="{StaticResource Brush.PositiveGreen}"/>
                        <Run Text=" · Gastos "/>
                        <Run Text="{Binding SummaryExpense}" Foreground="{StaticResource Brush.AlertAmber}"/>
                        <Run Text=" · Neto "/>
                        <Run Text="{Binding SummaryNet}" Foreground="{StaticResource Brush.AccentCyan}"/>
                    </TextBlock>
                </StackPanel>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding ActiveFilterChips}" Margin="16,0,8,0" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1A3A4A" CornerRadius="12" Padding="10,4" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource Brush.AccentCyan}" FontSize="11" VerticalAlignment="Center"/>
                                    <Button Content="×" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Brush.AccentCyan}"
                                            FontSize="12" Padding="6,0,0,0" Cursor="Hand"
                                            Command="{Binding DataContext.RemoveFilterChipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Grid.Column="2" Style="{StaticResource PremiumButton}" Content="Limpiar" Command="{Binding ClearFiltersCommand}" Margin="0,0,8,0"/>
                <Button Grid.Column="3" Style="{StaticResource PremiumButton}" Content="Guardar vista" Command="{Binding SaveFilterPresetCommand}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{Binding AdvancedColumnWidth}"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedTransaction}"
                      Style="{StaticResource PremiumDataGrid}" AutoGenerateColumns="False"
                      CanUserResizeColumns="True" RowHeight="44" Margin="0,0,12,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding Date}" Width="88" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Tipo" Width="100" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Type}" Foreground="{Binding TypeColor, Converter={StaticResource HexToBrush}}" VerticalAlignment="Center" FontSize="12"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="*" MinWidth="140" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Subcat." Binding="{Binding Subcategory}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Método" Binding="{Binding PaymentMethod}" Width="95" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Monto" Width="105" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Amount}" Foreground="{Binding AmountColor, Converter={StaticResource HexToBrush}}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Estado" Width="90" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StatusBadge}">
                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor, Converter={StaticResource HexToBrush}}" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Etiquetas" Binding="{Binding Tags}" Width="120" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Acciones" Width="220" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource TxActionButton}" Content="Editar"
                                            Command="{Binding DataContext.StartEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource TxActionButton}" Content="Dup."
                                            Command="{Binding DataContext.DuplicateRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource TxActionButton}" Content="Pagado"
                                            Command="{Binding DataContext.MarkPaidRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource TxActionButton}" Content="Rec."
                                            Command="{Binding DataContext.ToggleRecurringRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource TxActionButton}" Content="✕"
                                            Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Style="{StaticResource KpiCardBorder}" Margin="0,0,12,0"
                    Visibility="{Binding ShowAdvancedFilters, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=ActualHeight}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Filtros avanzados"/>
                        <TextBlock Style="{StaticResource FilterLabel}" Text="Desde"/>
                        <DatePicker SelectedDate="{Binding FilterDateFrom}"/>
                        <TextBlock Style="{StaticResource FilterLabel}" Text="Hasta"/>
                        <DatePicker SelectedDate="{Binding FilterDateTo}"/>
                        <TextBlock Style="{StaticResource FilterLabel}" Text="Tipo"/>
                        <ComboBox ItemsSource="{Binding TypeFilterOptions}" SelectedItem="{Binding SelectedTypeFilter}" DisplayMemberPath="Label"/>
                        <TextBlock Style="{StaticResource FilterLabel}" Text="Categoría"/>
                        <ComboBox ItemsSource="{Binding CategoryFilterOptions}" SelectedItem="{Binding SelectedCategoryFilter}" DisplayMemberPath="Name"/>
                        <TextBlock Style="{StaticResource FilterLabel}" Text="Subcategoría"/>
                        <ComboBox ItemsSource="{Binding SubcategoryFilterOptions}" SelectedItem="{Binding SelectedSubcategoryFilter}" DisplayMemberPath="Name"/>
                        <TextBlock Style="{StaticResource FilterLabel}" Text="Método de pago"/>
                        <ComboBox ItemsSource="{Binding PaymentMethodFilterOptions}" SelectedItem="{Binding SelectedPaymentMethodFilter}" DisplayMemberPath="Name"/>
                        <TextBlock Style="{StaticResource FilterLabel}" Text="Estado"/>
                        <ComboBox ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter}" DisplayMemberPath="Label"/>
                        <TextBlock Style="{StaticResource FilterLabel}" Text="Meta asociada"/>
                        <ComboBox ItemsSource="{Binding GoalFilterOptions}" SelectedItem="{Binding SelectedGoalFilter}" DisplayMemberPath="Name"/>
                        <TextBlock Style="{StaticResource FilterLabel}" Text="Monto mínimo"/>
                        <TextBox Text="{Binding FilterMinAmountText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource FilterLabel}" Text="Monto máximo"/>
                        <TextBox Text="{Binding FilterMaxAmountText, UpdateSourceTrigger=PropertyChanged}"/>
                        <CheckBox Content="Solo recurrentes" IsChecked="{Binding FilterRecurringOnly}" Margin="0,12,0,0"
                                  Foreground="{StaticResource Brush.TextPrimary}"/>
                        <Button Style="{StaticResource AccentButton}" Content="Aplicar filtros" Command="{Binding ApplyAdvancedFiltersCommand}" Margin="0,16,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource KpiCardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Detalle" Margin="0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource PremiumButton}" Content="Editar" Padding="10,6" FontSize="11"
                                        Command="{Binding StartEditCommand}" CommandParameter="{Binding SelectedTransaction}"
                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource FilterLabel}" Text="Fecha" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding EditDate}"/>
                            <TextBlock Style="{StaticResource FilterLabel}" Text="Tipo"/>
                            <ComboBox ItemsSource="{Binding EditTypeOptions}" SelectedItem="{Binding EditType}" DisplayMemberPath="Label"/>
                            <TextBlock Style="{StaticResource FilterLabel}" Text="Descripción"/>
                            <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource FilterLabel}" Text="Monto"/>
                            <TextBox Text="{Binding EditAmountText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource FilterLabel}" Text="Categoría"/>
                            <ComboBox ItemsSource="{Binding EditCategories}" SelectedItem="{Binding EditCategory}" DisplayMemberPath="Name"/>
                            <TextBlock Style="{StaticResource FilterLabel}" Text="Subcategoría"/>
                            <ComboBox ItemsSource="{Binding EditSubcategories}" SelectedItem="{Binding EditSubcategory}" DisplayMemberPath="Name"/>
                            <TextBlock Style="{StaticResource FilterLabel}" Text="Método de pago"/>
                            <ComboBox ItemsSource="{Binding EditPaymentMethods}" SelectedItem="{Binding EditPaymentMethod}" DisplayMemberPath="Name"/>
                            <TextBlock Style="{StaticResource FilterLabel}" Text="Estado"/>
                            <ComboBox ItemsSource="{Binding EditStatusOptions}" SelectedItem="{Binding EditStatus}" DisplayMemberPath="Label"/>
                            <TextBlock Style="{StaticResource FilterLabel}" Text="Meta"/>
                            <ComboBox ItemsSource="{Binding EditGoals}" SelectedItem="{Binding EditGoal}" DisplayMemberPath="Name"/>
                            <TextBlock Style="{StaticResource FilterLabel}" Text="Etiqueta"/>
                            <TextBox Text="{Binding EditTag, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource FilterLabel}" Text="Nota"/>
                            <TextBox Text="{Binding EditNote, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48"/>
                            <CheckBox Content="Recurrente" IsChecked="{Binding EditIsRecurring}" Margin="0,10,0,0"
                                      Foreground="{StaticResource Brush.TextPrimary}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Style="{StaticResource AccentButton}" Content="Guardar" Command="{Binding SaveEditCommand}" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource PremiumButton}" Content="Cancelar" Command="{Binding CancelEditCommand}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <TextBlock Text="Selecciona un movimiento de la tabla" Foreground="{StaticResource Brush.TextSecondary}"
                                       TextWrapping="Wrap" Margin="0,8,0,16">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTransaction}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel DataContext="{Binding SelectedTransaction}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource Brush.TextPrimary}"
                                           FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Amount}" Foreground="{StaticResource Brush.AccentCyan}" FontSize="22" FontWeight="Bold" Margin="0,8,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Fecha" Style="{StaticResource FilterLabel}" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding Date}" Foreground="{StaticResource Brush.TextPrimary}"/>
                                        <TextBlock Text="Tipo" Style="{StaticResource FilterLabel}"/>
                                        <TextBlock Text="{Binding Type}" Foreground="{Binding TypeColor, Converter={StaticResource HexToBrush}}"/>
                                        <TextBlock Text="Estado" Style="{StaticResource FilterLabel}"/>
                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor, Converter={StaticResource HexToBrush}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Categoría" Style="{StaticResource FilterLabel}" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding Category}" Foreground="{StaticResource Brush.TextPrimary}" TextWrapping="Wrap"/>
                                        <TextBlock Text="Subcategoría" Style="{StaticResource FilterLabel}"/>
                                        <TextBlock Text="{Binding Subcategory}" Foreground="{StaticResource Brush.TextPrimary}"/>
                                        <TextBlock Text="Método" Style="{StaticResource FilterLabel}"/>
                                        <TextBlock Text="{Binding PaymentMethod}" Foreground="{StaticResource Brush.TextPrimary}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Etiquetas" Style="{StaticResource FilterLabel}"/>
                                <TextBlock Text="{Binding Tags}" Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap"/>
                                <TextBlock Text="Meta" Style="{StaticResource FilterLabel}"/>
                                <TextBlock Text="{Binding GoalName, TargetNullValue=—}" Foreground="{StaticResource Brush.PositiveGreen}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <Button Style="{StaticResource AccentButton}" Content="Editar"
                                            Command="{Binding DataContext.StartEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource PremiumButton}" Content="Duplicar"
                                            Command="{Binding DataContext.DuplicateRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource PremiumButton}" Content="Pagado"
                                            Command="{Binding DataContext.MarkPaidRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource PremiumButton}" Content="Recurrente"
                                            Command="{Binding DataContext.ToggleRecurringRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource PremiumButton}" Content="Eliminar"
                                            Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
