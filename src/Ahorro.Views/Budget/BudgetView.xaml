<UserControl x:Class="Ahorro.Views.Budget.BudgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:Ahorro.Models.Enums;assembly=Ahorro.Models"
             xmlns:conv="clr-namespace:Ahorro.Themes.Converters;assembly=Ahorro.Themes"
             Background="{StaticResource Brush.BackgroundApp}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Ahorro.Views;component/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

            <Style x:Key="BudgetExecutiveKpi" TargetType="Border" BasedOn="{StaticResource KpiCardBorder}">
                <Setter Property="Padding" Value="20"/>
                <Setter Property="MinHeight" Value="108"/>
            </Style>

            <Style x:Key="BudgetRulePanel" TargetType="Border" BasedOn="{StaticResource KpiCardBorder}">
                <Setter Property="Padding" Value="22"/>
                <Setter Property="Background" Value="#121A24"/>
            </Style>

            <Style x:Key="BudgetRuleBucketCard" TargetType="Border">
                <Setter Property="Background" Value="#141C26"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderSubtle}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="16"/>
            </Style>

            <Style x:Key="BudgetActionButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Padding" Value="14,9"/>
            </Style>

            <Style x:Key="BudgetGridRow" TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAlert}" Value="True">
                        <Setter Property="Background" Value="#18FFB84D"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:BudgetLineStatus.Exceeded}">
                        <Setter Property="Background" Value="#18FF6B6B"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="BudgetInsightCard" TargetType="Border">
                <Setter Property="Background" Value="#141C26"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderSubtle}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1. Título + periodo -->
                <Grid Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageHeader}" Text="Presupuesto mensual"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border Background="#1A2A35" BorderBrush="{StaticResource Brush.AccentCyan}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                                <TextBlock Text="{Binding ActivePeriodBadge}" Foreground="{StaticResource Brush.AccentCyan}"
                                           FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"
                                       Text="{Binding PeriodLabel}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <ComboBox ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriodOption}"
                                  DisplayMemberPath="Label" Width="240" Margin="0,0,12,0"/>
                        <Button Style="{StaticResource GhostButton}" Content="Actualizar" Command="{Binding RefreshCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- 2. Resumen ejecutivo -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Resumen ejecutivo" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding SummaryKpis}" Margin="0,0,0,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource BudgetExecutiveKpi}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource Brush.TextSecondary}"
                                               FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Value}" Foreground="{Binding AccentBrush}"
                                               FontSize="22" FontWeight="Bold" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Brush.TextSecondary}"
                                               FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource KpiCardBorder}" Padding="18" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="INGRESO BRUTO" Foreground="{StaticResource Brush.TextSecondary}" FontSize="10"/>
                            <TextBox Text="{Binding GrossIncomeInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding GrossIncome}" Foreground="{StaticResource Brush.TextSecondary}" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="INGRESO LÍQUIDO DISPONIBLE" Foreground="{StaticResource Brush.TextSecondary}" FontSize="10"/>
                            <TextBox Text="{Binding NetIncomeInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding NetIncome}" Foreground="{StaticResource Brush.PositiveGreen}" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource AccentButton}" Content="Guardar ingresos"
                                Command="{Binding SaveIncomeCommand}" VerticalAlignment="Bottom"/>
                    </Grid>
                </Border>

                <!-- 3. Regla 50/30/20 + acciones -->
                <Grid Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button Style="{StaticResource BudgetActionButton}" Content="Duplicar mes anterior"
                                Command="{Binding DuplicatePreviousMonthCommand}"/>
                        <Button Style="{StaticResource BudgetActionButton}" Content="Recalcular distribución"
                                Command="{Binding RecalculateDistributionCommand}"/>
                        <Button Style="{StaticResource AccentButton}" Content="+ Categoría" Command="{Binding AddCategoryCommand}"
                                Margin="0,0,8,0" Padding="14,9"/>
                        <Button Style="{StaticResource AccentButton}" Content="+ Subcategoría" Command="{Binding AddSubcategoryCommand}"
                                Margin="0,0,8,0" Padding="14,9"/>
                        <Button Style="{StaticResource BudgetActionButton}" Content="Ajustar regla"
                                Command="{Binding ToggleRulePanelCommand}"/>
                    </WrapPanel>

                    <Border Grid.Row="1" Style="{StaticResource BudgetRulePanel}"
                            Visibility="{Binding IsRulePanelExpanded, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Regla 50 / 30 / 20" Margin="0"/>
                                    <TextBlock Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" TextWrapping="Wrap"
                                               Text="Panel de configuración presupuestaria. Define el reparto del ingreso líquido y recalcula la distribución por grupo."/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding RuleTotalLabel}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.PositiveGreen}" HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RuleTotalValid}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.CriticalRed}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Total regla" Foreground="{StaticResource Brush.TextSecondary}" FontSize="10"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding RuleBuckets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource BudgetRuleBucketCard}" Margin="0,0,12,0"
                                                BorderBrush="{Binding AccentBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" Foreground="{Binding AccentBrush}"
                                                           FontSize="10" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Hint}" Foreground="{StaticResource Brush.TextSecondary}"
                                                           FontSize="11" Margin="0,2,0,12"/>
                                                <TextBlock Text="{Binding PercentLabel}" FontWeight="SemiBold"
                                                           Foreground="{Binding AccentBrush}" FontSize="16" Margin="0,0,0,10"/>
                                                <TextBlock Text="{Binding TargetAmount}" FontSize="20" FontWeight="Bold"
                                                           Foreground="{Binding AccentBrush}"/>
                                                <TextBlock Margin="0,4,0,8" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}">
                                                    <Run Text="Real: "/>
                                                    <Run Text="{Binding ActualAmount}" Foreground="{StaticResource Brush.TextPrimary}"/>
                                                </TextBlock>
                                                <ProgressBar Style="{StaticResource BudgetUsageProgressBar}" Maximum="1.2"
                                                             Value="{Binding UsageRatio}" Foreground="{Binding AccentBrush}" Height="6"/>
                                                <TextBlock Text="{Binding DeltaLabel}" FontSize="10"
                                                           Foreground="{StaticResource Brush.TextSecondary}" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                                    <TextBlock Text="Necesidades" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding NeedsPercent, UpdateSourceTrigger=PropertyChanged}" Width="72"/>
                                    <TextBlock Text="%" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
                                    <TextBlock Text="Deseos" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding WantsPercent, UpdateSourceTrigger=PropertyChanged}" Width="72"/>
                                    <TextBlock Text="%" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="Ahorro / deuda" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding SavingsPercent, UpdateSourceTrigger=PropertyChanged}" Width="72"/>
                                    <TextBlock Text="%" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource AlertStripBorder}" Margin="0,16,0,0" Padding="12,8">
                                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Brush.TextSecondary}"
                                           FontSize="11" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Alta rápida categorías -->
                <Border Style="{StaticResource KpiCardBorder}" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,8,0"
                                     Tag="Nueva categoría"/>
                            <ComboBox ItemsSource="{Binding GroupOptions}" SelectedItem="{Binding SelectedGroupOption}"
                                      DisplayMemberPath="Label" Width="150" Margin="0,0,8,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                      DisplayMemberPath="Name" Width="170" Margin="0,0,8,0"/>
                            <TextBox Text="{Binding NewSubcategoryName, UpdateSourceTrigger=PropertyChanged}" Width="180"
                                     Tag="Nueva subcategoría"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 4. Tabla analítica -->
                <Border Style="{StaticResource KpiCardBorder}" Padding="0">
                    <StackPanel>
                        <Grid Margin="16,16,16,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Detalle por categoría" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding LineCountLabel}" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="Ejecución global" Foreground="{StaticResource Brush.TextSecondary}" FontSize="10" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding ExecutionPercent}" Foreground="{StaticResource Brush.AccentCyan}"
                                           FontSize="18" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <ProgressBar Style="{StaticResource BudgetUsageProgressBar}" Maximum="1.2"
                                             Value="{Binding ExecutionRatio}" Width="160" Margin="0,6,0,0"
                                             Foreground="{StaticResource Brush.AccentCyan}"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                                  Style="{StaticResource PremiumDataGrid}" MinHeight="440" Margin="1"
                                  AutoGenerateColumns="False" CanUserSortColumns="True" IsReadOnly="True"
                                  RowStyle="{StaticResource BudgetGridRow}" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Categoría" Width="140" SortMemberPath="Category">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                                <Ellipse Width="8" Height="8" Fill="{Binding CategoryBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource Brush.TextPrimary}" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Subcategoría" Binding="{Binding Subcategory}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="4,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Asignación" Binding="{Binding AllocationMode}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Presupuesto" Binding="{Binding Planned}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.AccentCyan}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Real" Binding="{Binding Actual}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Diferencia" Binding="{Binding Difference}" Width="115">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.PositiveGreen}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:BudgetLineStatus.Exceeded}">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.CriticalRed}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Usado" Width="150" SortMemberPath="UsedPercent">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="4,0">
                                                <Grid>
                                                    <ProgressBar Style="{StaticResource BudgetUsageProgressBar}"
                                                                 Value="{Binding UsedPercent}"
                                                                 Foreground="{Binding ProgressBrush}"/>
                                                    <TextBlock Text="{Binding UsedPercentText}" FontSize="10" FontWeight="SemiBold"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#E8EDF5"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAlert}" Value="True">
                                                                        <Setter Property="Foreground" Value="#1A2430"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Estado" Width="110" SortMemberPath="StatusLabel">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Margin="4,0">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource BudgetStatusBadge}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:BudgetLineStatus.Exceeded}">
                                                                <Setter Property="Background" Value="#33FF6B6B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:BudgetLineStatus.Attention}">
                                                                <Setter Property="Background" Value="#33FFB84D"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:BudgetLineStatus.Limit}">
                                                                <Setter Property="Background" Value="#3327D3FF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusBrush}"
                                                           HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                            <DataGrid.InputBindings>
                                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding SelectLineForSubcategoryCommand}"
                                              CommandParameter="{Binding SelectedLine}"/>
                            </DataGrid.InputBindings>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Panel lateral: alertas -->
        <Border Grid.Column="1" Style="{StaticResource KpiCardBorder}" Margin="20,0,0,0" Padding="18" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Alertas presupuestarias"/>
                <TextBlock Foreground="{StaticResource Brush.TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"
                           Text="Categorías críticas, excesos y desvíos del objetivo de ahorro en el periodo activo."/>

                <ItemsControl ItemsSource="{Binding BudgetInsights}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource BudgetInsightCard}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{Binding AccentBrush}"/>
                                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource Brush.TextSecondary}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource SectionTitle}" Text="Listado rápido" Margin="0,16,0,10"/>
                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Alerts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Message}" Foreground="{StaticResource Brush.AlertAmber}"
                                           TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Margin="0,16,0,0" Padding="14" CornerRadius="10" Background="#141C26"
                        BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="DIFERENCIA DISPONIBLE" Foreground="{StaticResource Brush.TextSecondary}" FontSize="10"/>
                        <TextBlock Text="{Binding AvailableDifference}" FontSize="22" FontWeight="Bold"
                                   Foreground="{Binding AvailableDifferenceBrush}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding RemainingBudget}" Foreground="{StaticResource Brush.TextSecondary}"
                                   FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
