<UserControl x:Class="Ahorro.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="{StaticResource Brush.BackgroundApp}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageHeader}" Text="Centro de mando"/>
                    <TextBlock Foreground="{StaticResource Brush.TextSecondary}" Text="{Binding PeriodLabel}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ComboBox ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriodOption}"
                              DisplayMemberPath="Label" Width="220" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource AccentButton}" Content="Actualizar" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding Kpis}" Margin="0,0,0,20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource KpiCardBorder}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource Brush.TextSecondary}" FontSize="{StaticResource FontSize.Caption}" Text="{Binding Title}"/>
                                <TextBlock Foreground="{Binding AccentColor}" FontSize="22" FontWeight="Bold" Text="{Binding Value}" Margin="0,6,0,0"/>
                                <TextBlock Foreground="{StaticResource Brush.TextSecondary}" FontSize="{StaticResource FontSize.Caption}" Text="{Binding Subtitle}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiCardBorder}" Margin="0,0,12,0" Padding="16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Presupuesto vs real"/>
                        <lvc:CartesianChart Series="{Binding ComparisonSeries}" Height="280"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource KpiCardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Próximos pagos"/>
                            <ItemsControl ItemsSource="{Binding UpcomingPayments}" MaxHeight="140">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Brush.TextPrimary}"/>
                                            <TextBlock Text="{Binding Amount}" HorizontalAlignment="Right" Foreground="{StaticResource Brush.AccentCyan}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Alertas"/>
                            <ItemsControl ItemsSource="{Binding Alerts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource Brush.AlertAmber}" TextWrapping="Wrap" Margin="0,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiCardBorder}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Distribución"/>
                        <lvc:PieChart Series="{Binding DistributionSeries}" Height="200"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource KpiCardBorder}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Tendencia mensual"/>
                        <lvc:CartesianChart Series="{Binding TrendSeries}" Height="200"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource KpiCardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Metas activas"/>
                        <ItemsControl ItemsSource="{Binding ActiveGoals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Brush.TextPrimary}"/>
                                        <ProgressBar Style="{StaticResource GoalProgressBar}" Value="{Binding Progress}" Maximum="1"/>
                                        <TextBlock Text="{Binding PercentText}" Foreground="{StaticResource Brush.TextSecondary}" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiCardBorder}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Categorías críticas"/>
                        <ItemsControl ItemsSource="{Binding CriticalCategories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <TextBlock Text="{Binding Category}"/>
                                        <TextBlock Text="{Binding UsedPercent}" HorizontalAlignment="Right" Foreground="{StaticResource Brush.AlertAmber}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource KpiCardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Movimientos recientes"/>
                        <ItemsControl ItemsSource="{Binding RecentTransactions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource Brush.TextPrimary}"/>
                                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Amount}" HorizontalAlignment="Right" Foreground="{StaticResource Brush.TextPrimary}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
