<UserControl x:Class="Ahorro.Views.Transactions.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Ahorro.Themes.Converters;assembly=Ahorro.Themes"
             Background="{StaticResource Brush.BackgroundApp}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Ahorro.Views;component/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:HexToBrushConverter x:Key="HexToBrush"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

            <Style x:Key="TxToolbarButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="MinHeight" Value="36"/>
            </Style>
            <Style x:Key="TxSearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Width" Value="260"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Padding" Value="12,9"/>
            </Style>
            <Style x:Key="TxFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource SettingsMetaLabel}">
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>
            <Style x:Key="TxDetailValue" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
                <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="TypeBadge" TargetType="Border">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>
            <Style x:Key="StatusBadge" TargetType="Border">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>
            <Style x:Key="LinkChipBorder" TargetType="Border">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Background" Value="#141C26"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderSubtle}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Margin" Value="0,0,6,6"/>
            </Style>
            <Style x:Key="ActiveFilterChip" TargetType="Border">
                <Setter Property="Background" Value="#1A3A4A"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
            </Style>
            <Style x:Key="StatKpiLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
            </Style>
            <Style x:Key="StatKpiValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
            </Style>
            <Style x:Key="CompactFilterField" TargetType="StackPanel">
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Style="{StaticResource PageHeader}" Text="Movimientos"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Brush.TextSecondary}"
                           FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Toolbar analítica -->
        <Border Grid.Row="1" Style="{StaticResource KpiCardBorder}" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBox Style="{StaticResource TxSearchBox}" Margin="0,0,8,0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Buscar por descripción, nota o etiqueta"/>
                        <ComboBox ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriodOption}"
                                  DisplayMemberPath="Label" Width="200" Margin="0,0,8,0" MinHeight="36"/>
                        <Button Style="{StaticResource TxToolbarButton}" Content="Filtros avanzados"
                                Command="{Binding ToggleAdvancedFiltersCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource TxToolbarButton}" Content="Limpiar" Command="{Binding ClearFiltersCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource TxToolbarButton}" Content="Guardar vista" Command="{Binding SaveFilterPresetCommand}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource TxToolbarButton}" Content="Exportar" Command="{Binding ExportCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource AccentButton}" Content="+ Nuevo" Command="{Binding StartAddCommand}" MinHeight="36"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ItemsControl Grid.Column="0" ItemsSource="{Binding QuickFilters}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource FilterChipToggle}" Content="{Binding Label}"
                                              IsChecked="{Binding IsActive, Mode=TwoWay}"
                                              Command="{Binding DataContext.ToggleQuickFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#141C26" CornerRadius="10" Padding="14,8" Margin="0,0,8,0" MinWidth="110">
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatKpiLabel}" Text="MOVIMIENTOS"/>
                                <TextBlock Style="{StaticResource StatKpiValue}" Text="{Binding FilterSummary}"
                                           Foreground="{StaticResource Brush.TextPrimary}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#141C26" CornerRadius="10" Padding="14,8" Margin="0,0,8,0" MinWidth="120">
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatKpiLabel}" Text="TOTAL NETO"/>
                                <TextBlock Style="{StaticResource StatKpiValue}" Text="{Binding SummaryTotal}"
                                           Foreground="{StaticResource Brush.AccentCyan}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#141C26" CornerRadius="10" Padding="14,8" MinWidth="200">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource StatKpiLabel}" Text="INGRESOS"/>
                                    <TextBlock Style="{StaticResource StatKpiValue}" Text="{Binding SummaryIncome}"
                                               Foreground="{StaticResource Brush.PositiveGreen}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource StatKpiLabel}" Text="GASTOS"/>
                                    <TextBlock Style="{StaticResource StatKpiValue}" Text="{Binding SummaryExpense}"
                                               Foreground="{StaticResource Brush.AlertAmber}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource StatKpiLabel}" Text="NETO"/>
                                    <TextBlock Style="{StaticResource StatKpiValue}" Text="{Binding SummaryNet}"
                                               Foreground="{StaticResource Brush.AccentCyan}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Chips activos -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding ActiveFilterChips}" Margin="0,0,0,10"
                      Visibility="{Binding HasActiveFilterChips, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ActiveFilterChip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource Brush.AccentCyan}" FontSize="11" VerticalAlignment="Center"/>
                            <Button Content="×" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Brush.AccentCyan}"
                                    FontSize="12" Padding="6,0,0,0" Cursor="Hand"
                                    Command="{Binding DataContext.RemoveFilterChipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Workstation principal -->
        <Grid Grid.Row="3" MinHeight="400">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{Binding AdvancedColumnWidth}"/>
                <ColumnDefinition Width="352"/>
            </Grid.ColumnDefinitions>

            <!-- Tabla -->
            <Border Grid.Column="0" Style="{StaticResource KpiCardBorder}" Padding="0" Margin="0,0,10,0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedTransaction}"
                              Style="{StaticResource PremiumDataGrid}" AutoGenerateColumns="False"
                              CanUserResizeColumns="True" RowStyle="{StaticResource PremiumDataGridRow}"
                              RowHeight="42" BorderThickness="0" Background="Transparent"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              SelectionUnit="FullRow" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="FECHA" Binding="{Binding Date}" Width="86" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="TIPO" Width="108" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TypeBadge}"
                                                Background="{Binding TypeBadgeBackground, Converter={StaticResource HexToBrush}}">
                                            <TextBlock Text="{Binding Type}" Foreground="{Binding TypeColor, Converter={StaticResource HexToBrush}}"
                                                       FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Description}" Width="*" MinWidth="160" IsReadOnly="True"/>
                            <DataGridTextColumn Header="CATEGORÍA" Binding="{Binding Category}" Width="118" IsReadOnly="True"/>
                            <DataGridTextColumn Header="SUBCAT." Binding="{Binding Subcategory}" Width="96" IsReadOnly="True"/>
                            <DataGridTextColumn Header="MÉTODO" Binding="{Binding PaymentMethod}" Width="100" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="MONTO" Width="108" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Amount}" Foreground="{Binding AmountColor, Converter={StaticResource HexToBrush}}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="ESTADO" Width="96" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadge}"
                                                Background="{Binding StatusBadgeBackground, Converter={StaticResource HexToBrush}}">
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor, Converter={StaticResource HexToBrush}}"
                                                       FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ETIQUETAS" Binding="{Binding Tags}" Width="130" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Background="#CC0E141C" CornerRadius="12"
                            Visibility="{Binding IsResultsEmpty, Converter={StaticResource BoolToVis}}"
                            Margin="16">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Sin resultados" Foreground="{StaticResource Brush.TextPrimary}"
                                       FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Ajusta los filtros o limpia la búsqueda para ver movimientos."
                                       Foreground="{StaticResource Brush.TextSecondary}" FontSize="12"
                                       TextWrapping="Wrap" MaxWidth="320" TextAlignment="Center" Margin="0,8,0,0"/>
                            <Button Style="{StaticResource AccentButton}" Content="Limpiar filtros"
                                    Command="{Binding ClearFiltersCommand}" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Filtros avanzados compactos -->
            <Border Grid.Column="1" Style="{StaticResource KpiCardBorder}" Padding="14,12" Margin="0,0,10,0"
                    Visibility="{Binding ShowAdvancedFilters, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Refinar" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Style="{StaticResource CompactFilterField}">
                                <TextBlock Style="{StaticResource TxFieldLabel}" Text="Desde"/>
                                <DatePicker SelectedDate="{Binding FilterDateFrom}" MinHeight="34"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Style="{StaticResource CompactFilterField}">
                                <TextBlock Style="{StaticResource TxFieldLabel}" Text="Hasta"/>
                                <DatePicker SelectedDate="{Binding FilterDateTo}" MinHeight="34"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Style="{StaticResource CompactFilterField}">
                                <TextBlock Style="{StaticResource TxFieldLabel}" Text="Mínimo"/>
                                <TextBox Text="{Binding FilterMinAmountText, UpdateSourceTrigger=PropertyChanged}" MinHeight="34"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Style="{StaticResource CompactFilterField}">
                                <TextBlock Style="{StaticResource TxFieldLabel}" Text="Máximo"/>
                                <TextBox Text="{Binding FilterMaxAmountText, UpdateSourceTrigger=PropertyChanged}" MinHeight="34"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Style="{StaticResource CompactFilterField}">
                            <TextBlock Style="{StaticResource TxFieldLabel}" Text="Tipo"/>
                            <ComboBox ItemsSource="{Binding TypeFilterOptions}" SelectedItem="{Binding SelectedTypeFilter}"
                                      DisplayMemberPath="Label" MinHeight="34"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource CompactFilterField}">
                            <TextBlock Style="{StaticResource TxFieldLabel}" Text="Estado"/>
                            <ComboBox ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter}"
                                      DisplayMemberPath="Label" MinHeight="34"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource CompactFilterField}">
                            <TextBlock Style="{StaticResource TxFieldLabel}" Text="Categoría"/>
                            <ComboBox ItemsSource="{Binding CategoryFilterOptions}" SelectedItem="{Binding SelectedCategoryFilter}"
                                      DisplayMemberPath="Name" MinHeight="34"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource CompactFilterField}">
                            <TextBlock Style="{StaticResource TxFieldLabel}" Text="Subcategoría"/>
                            <ComboBox ItemsSource="{Binding SubcategoryFilterOptions}" SelectedItem="{Binding SelectedSubcategoryFilter}"
                                      DisplayMemberPath="Name" MinHeight="34"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource CompactFilterField}">
                            <TextBlock Style="{StaticResource TxFieldLabel}" Text="Método"/>
                            <ComboBox ItemsSource="{Binding PaymentMethodFilterOptions}" SelectedItem="{Binding SelectedPaymentMethodFilter}"
                                      DisplayMemberPath="Name" MinHeight="34"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource CompactFilterField}">
                            <TextBlock Style="{StaticResource TxFieldLabel}" Text="Meta"/>
                            <ComboBox ItemsSource="{Binding GoalFilterOptions}" SelectedItem="{Binding SelectedGoalFilter}"
                                      DisplayMemberPath="Name" MinHeight="34"/>
                        </StackPanel>

                        <CheckBox Content="Solo recurrentes" IsChecked="{Binding FilterRecurringOnly}" Margin="0,2,0,0"
                                  Foreground="{StaticResource Brush.TextPrimary}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Panel detalle -->
            <Border Grid.Column="2" Style="{StaticResource KpiCardBorder}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}" Text="Detalle" Margin="0,0,0,8"/>

                    <!-- Empty state -->
                    <Border Grid.Row="1" CornerRadius="10" Background="#141C26" Padding="20"
                            Visibility="{Binding ShowDetailPlaceholder, Converter={StaticResource BoolToVis}}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="◎" FontSize="28" Foreground="{StaticResource Brush.BorderSubtle}"
                                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Selecciona un movimiento para ver su detalle"
                                       Foreground="{StaticResource Brush.TextSecondary}" FontSize="13"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Edición inline -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TxFieldLabel}" Text="Fecha"/>
                            <DatePicker SelectedDate="{Binding EditDate}" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource TxFieldLabel}" Text="Tipo"/>
                            <ComboBox ItemsSource="{Binding EditTypeOptions}" SelectedItem="{Binding EditType}" DisplayMemberPath="Label" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource TxFieldLabel}" Text="Descripción"/>
                            <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource TxFieldLabel}" Text="Monto"/>
                            <TextBox Text="{Binding EditAmountText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource TxFieldLabel}" Text="Categoría"/>
                            <ComboBox ItemsSource="{Binding EditCategories}" SelectedItem="{Binding EditCategory}" DisplayMemberPath="Name" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource TxFieldLabel}" Text="Subcategoría"/>
                            <ComboBox ItemsSource="{Binding EditSubcategories}" SelectedItem="{Binding EditSubcategory}" DisplayMemberPath="Name" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource TxFieldLabel}" Text="Método"/>
                            <ComboBox ItemsSource="{Binding EditPaymentMethods}" SelectedItem="{Binding EditPaymentMethod}" DisplayMemberPath="Name" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource TxFieldLabel}" Text="Estado"/>
                            <ComboBox ItemsSource="{Binding EditStatusOptions}" SelectedItem="{Binding EditStatus}" DisplayMemberPath="Label" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource TxFieldLabel}" Text="Meta"/>
                            <ComboBox ItemsSource="{Binding EditGoals}" SelectedItem="{Binding EditGoal}" DisplayMemberPath="Name" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource TxFieldLabel}" Text="Etiqueta"/>
                            <TextBox Text="{Binding EditTag, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource TxFieldLabel}" Text="Nota"/>
                            <TextBox Text="{Binding EditNote, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56" Margin="0,0,0,8"/>
                            <CheckBox Content="Recurrente" IsChecked="{Binding EditIsRecurring}" Foreground="{StaticResource Brush.TextPrimary}" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource AccentButton}" Content="Guardar" Command="{Binding SaveEditCommand}" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource PremiumButton}" Content="Cancelar" Command="{Binding CancelEditCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Inspección -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <StackPanel DataContext="{Binding SelectedTransaction}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.HasSelectedTransaction, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource Brush.TextPrimary}"
                                       FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding Date}" Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" Margin="0,0,0,10"/>

                            <Border Background="#141C26" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource StatKpiLabel}" Text="MONTO"/>
                                        <TextBlock Text="{Binding Amount}" FontSize="26" FontWeight="Bold"
                                                   Foreground="{Binding AmountColor, Converter={StaticResource HexToBrush}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Border Style="{StaticResource TypeBadge}"
                                                Background="{Binding TypeBadgeBackground, Converter={StaticResource HexToBrush}}" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Type}" Foreground="{Binding TypeColor, Converter={StaticResource HexToBrush}}"
                                                       FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Style="{StaticResource StatusBadge}"
                                                Background="{Binding StatusBadgeBackground, Converter={StaticResource HexToBrush}}">
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor, Converter={StaticResource HexToBrush}}"
                                                       FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding LinkChips}" Margin="0,0,0,10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource LinkChipBorder}">
                                            <TextBlock Text="{Binding Label}" FontSize="10"
                                                       Foreground="{Binding ColorHex, Converter={StaticResource HexToBrush}}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <StackPanel Margin="0,0,8,10">
                                    <TextBlock Style="{StaticResource TxFieldLabel}" Text="Categoría"/>
                                    <TextBlock Style="{StaticResource TxDetailValue}" Text="{Binding Category}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource TxFieldLabel}" Text="Método"/>
                                    <TextBlock Style="{StaticResource TxDetailValue}" Text="{Binding PaymentMethod}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,10" Visibility="{Binding HasSubcategory, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource TxFieldLabel}" Text="Subcategoría"/>
                                    <TextBlock Style="{StaticResource TxDetailValue}" Text="{Binding Subcategory}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource TxFieldLabel}" Text="Etiqueta"/>
                                    <TextBlock Style="{StaticResource TxDetailValue}" Text="{Binding Tag, TargetNullValue=—}"/>
                                </StackPanel>
                            </UniformGrid>

                            <Border Background="#141C26" CornerRadius="8" Padding="12,10" Margin="0,0,0,12"
                                    Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TxFieldLabel}" Text="Nota" Margin="0"/>
                                    <TextBlock Text="{Binding Note}" Foreground="{StaticResource Brush.TextSecondary}"
                                               FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource TxFieldLabel}" Text="Etiquetas compuestas"/>
                            <TextBlock Text="{Binding Tags}" Foreground="{StaticResource Brush.TextSecondary}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <Border BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TxFieldLabel}" Text="Acciones" Margin="0,0,0,8"/>
                                    <UniformGrid Columns="2" Margin="0,0,0,8">
                                        <Button Style="{StaticResource AccentButton}" Content="Editar" Margin="0,0,6,6"
                                                Command="{Binding DataContext.StartEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource PremiumButton}" Content="Duplicar" Margin="0,0,0,6"
                                                Command="{Binding DataContext.DuplicateRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource PremiumButton}" Content="Marcar pagado" Margin="0,0,6,0"
                                                Command="{Binding DataContext.MarkPaidRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource PremiumButton}" Content="Recurrente" Margin="0,0,0,0"
                                                Command="{Binding DataContext.ToggleRecurringRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </UniformGrid>
                                    <Button Style="{StaticResource DangerButton}" Content="Eliminar" HorizontalAlignment="Stretch"
                                            Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
