<UserControl x:Class="Ahorro.Views.Reports.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:conv="clr-namespace:Ahorro.Themes.Converters;assembly=Ahorro.Themes"
             Background="{StaticResource Brush.BackgroundApp}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Ahorro.Views;component/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

            <Style x:Key="ReportsKpiCard" TargetType="Border" BasedOn="{StaticResource KpiCardBorder}">
                <Setter Property="Padding" Value="16,14"/>
                <Setter Property="MinHeight" Value="100"/>
            </Style>

            <Style x:Key="ReportsPanelCard" TargetType="Border" BasedOn="{StaticResource KpiCardBorder}">
                <Setter Property="Padding" Value="16"/>
            </Style>

            <Style x:Key="ReportsInsightRow" TargetType="Border">
                <Setter Property="Background" Value="#141C26"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderSubtle}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- 1. Cabecera -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Style="{StaticResource PageHeader}" Text="Reportes"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Border Background="#1A2A35" BorderBrush="{StaticResource Brush.AccentCyan}"
                                BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                            <TextBlock Text="{Binding ActivePeriodBadge}" Foreground="{StaticResource Brush.AccentCyan}"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"
                                   Text="{Binding PeriodLabel}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <ComboBox Style="{StaticResource PremiumComboBox}"
                              ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriodOption}"
                              DisplayMemberPath="Label" Width="240" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource GhostButton}" Content="Actualizar" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource ReportsPanelCard}" Margin="0,0,0,16" Padding="12,10"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Brush.AccentCyan}"
                           FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <!-- 2. Resumen ejecutivo -->
            <ItemsControl ItemsSource="{Binding SummaryKpis}" Margin="0,0,0,20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ReportsKpiCard}" Margin="0,0,12,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Foreground="{StaticResource Brush.TextSecondary}"
                                           FontSize="{StaticResource FontSize.Caption}" Text="{Binding Title}"/>
                                <TextBlock Foreground="{Binding AccentBrush}" FontSize="21" FontWeight="Bold"
                                           Text="{Binding Value}" Margin="0,6,0,0"/>
                                <TextBlock Foreground="{StaticResource Brush.TextSecondary}" FontSize="10"
                                           Text="{Binding Subtitle}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 3. Ahorro acumulado + exportación contextual -->
            <Border Style="{StaticResource ReportsPanelCard}" Margin="0,0,0,20" Padding="18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Ahorro acumulado en metas" Margin="0"/>
                        <TextBlock Text="{Binding AccumulatedSavingsSubtitle}" FontSize="11"
                                   Foreground="{StaticResource Brush.TextSecondary}" Margin="0,4,0,10"/>
                        <TextBlock Text="{Binding AccumulatedSavings}" FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.PositiveGreen}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource AccentButton}" Content="Reporte periodo → PDF"
                                Command="{Binding ExportReportPdfCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource PremiumButton}" Content="Metas → Excel"
                                Command="{Binding ExportGoalsExcelCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource PremiumButton}" Content="Metas → PDF"
                                Command="{Binding ExportGoalsPdfCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4. Análisis por categoría y tendencia -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ReportsPanelCard}" Margin="0,0,12,0" MinHeight="300">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Gasto por categoría" Margin="0"/>
                            <TextBlock Text="{Binding CategorySubtitle}" FontSize="11"
                                       Foreground="{StaticResource Brush.TextSecondary}"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="148"/>
                            </Grid.ColumnDefinitions>
                            <lvc:CartesianChart Grid.Column="0"
                                                Series="{Binding CategorySeries}"
                                                XAxes="{Binding CategoryXAxes}"
                                                YAxes="{Binding CategoryYAxes}"
                                                LegendPosition="{Binding CategoryLegendPosition}"
                                                Height="280"/>
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="10,0,0,0">
                                <ItemsControl ItemsSource="{Binding CategoryLegend}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="8" Height="8" CornerRadius="2"
                                                        Background="{Binding AccentBrush}" VerticalAlignment="Top"
                                                        Margin="0,3,6,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Category}" FontSize="11"
                                                               Foreground="{StaticResource Brush.TextPrimary}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock FontSize="10" Foreground="{StaticResource Brush.TextSecondary}">
                                                        <Run Text="{Binding Amount}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding PercentLabel}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ReportsPanelCard}" MinHeight="300">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Tendencia mensual" Margin="0"/>
                        <TextBlock Text="{Binding TrendSubtitle}" FontSize="11"
                                   Foreground="{StaticResource Brush.TextSecondary}" Margin="0,2,0,8"/>
                        <lvc:CartesianChart Series="{Binding TrendSeries}"
                                            XAxes="{Binding TrendXAxes}"
                                            YAxes="{Binding TrendYAxes}"
                                            LegendPosition="{Binding TrendLegendPosition}"
                                            Height="280"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 5. Evolución histórica -->
            <Border Style="{StaticResource ReportsPanelCard}" Margin="0,0,0,20" Padding="18,16" MinHeight="320">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Ahorro acumulado por periodo" Margin="0"/>
                    <TextBlock Text="{Binding SavingsHistorySubtitle}" FontSize="11"
                               Foreground="{StaticResource Brush.TextSecondary}" Margin="0,2,0,12"/>
                    <lvc:CartesianChart Series="{Binding SavingsSeries}"
                                        XAxes="{Binding SavingsXAxes}"
                                        YAxes="{Binding SavingsYAxes}"
                                        LegendPosition="{Binding SavingsLegendPosition}"
                                        Height="280"/>
                </StackPanel>
            </Border>

            <!-- Detalle analítico -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ReportsPanelCard}" Margin="0,0,12,0" MinHeight="220">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Top gastos del periodo"/>
                        <TextBlock DockPanel.Dock="Top" Text="Sin movimientos de gasto"
                                   Foreground="{StaticResource Brush.TextSecondary}" FontSize="11" Margin="0,0,0,8"
                                   Visibility="{Binding HasTopExpenses, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="280">
                            <ItemsControl ItemsSource="{Binding TopExpenses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11"
                                                    Background="#1A2430" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Rank}" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource Brush.AccentCyan}"
                                                           FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Description}"
                                                       Foreground="{StaticResource Brush.TextPrimary}"
                                                       FontSize="12" VerticalAlignment="Center" Margin="8,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Amount}"
                                                       Foreground="{StaticResource Brush.AlertAmber}"
                                                       FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ReportsPanelCard}" MinHeight="220">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Categorías más excedidas"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="280">
                            <ItemsControl ItemsSource="{Binding ExceededCategories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ReportsInsightRow}">
                                            <Grid>
                                                <StackPanel Margin="0,0,52,0">
                                                    <TextBlock Text="{Binding Category}" Foreground="{Binding AccentBrush}"
                                                               FontWeight="SemiBold" FontSize="12"/>
                                                    <TextBlock Margin="0,4,0,0" FontSize="10"
                                                               Foreground="{StaticResource Brush.TextSecondary}">
                                                        <Run Text="Plan: "/><Run Text="{Binding Planned}"/>
                                                        <Run Text=" · Real: "/><Run Text="{Binding Actual}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Text="{Binding UsedPercent}" HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Foreground="#FF6B6B" FontWeight="Bold" FontSize="14"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Exportaciones del módulo -->
            <Border Style="{StaticResource ReportsPanelCard}" Padding="16">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Exportar datos" Margin="0,0,0,4"/>
                    <TextBlock Text="Movimientos y presupuesto del periodo seleccionado · metas de ahorro globales"
                               FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Style="{StaticResource AccentButton}" Content="Movimientos → Excel"
                                Command="{Binding ExportTransactionsExcelCommand}" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource PremiumButton}" Content="Presupuesto → Excel"
                                Command="{Binding ExportBudgetExcelCommand}" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource PremiumButton}" Content="Presupuesto → PDF"
                                Command="{Binding ExportBudgetPdfCommand}" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource AccentButton}" Content="Reporte periodo → PDF"
                                Command="{Binding ExportReportPdfCommand}" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource GhostButton}" Content="Metas de ahorro → Excel"
                                Command="{Binding ExportGoalsExcelCommand}" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource GhostButton}" Content="Metas de ahorro → PDF"
                                Command="{Binding ExportGoalsPdfCommand}" Margin="0,0,8,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
